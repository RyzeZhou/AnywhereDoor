<Window x:Class="Awd.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="clr-namespace:Awd.GUI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="任意门"
        Width="640" Height="480" MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Surface}"
        FontFamily="{StaticResource Font.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{StaticResource Header.Height}"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 磁贴（程序页）：84×84，单击=启动，拖拽=换位 -->
        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Width" Value="{StaticResource Tile.Size}"/>
            <Setter Property="Height" Value="{StaticResource Tile.Size}"/>
            <Setter Property="Margin" Value="{StaticResource Tile.Margin}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}"/>
            <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- 特效不挂在这层：DropShadow 会把整棵子树栅格化成灰阶（ClearType 集体失效），
                 标签文字必须留在特效外 —— 阴影改由背景层 TileShadowLayer 专管。 -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Card.Hover}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Card.Border.Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 阴影背景层：唯一携带 TileShadow 的元素，只画卡片底色不装内容，
             文字/图标作为其兄弟在上层照常 ClearType。 -->
        <Style x:Key="TileShadowLayer" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=tileRoot}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Card.Hover}"/>
                    <Setter Property="Effect" Value="{StaticResource TileShadow}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 列表行：路径/网址是文本形态 -->
        <Style x:Key="RowStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Default}"/>
            <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Card.Hover}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Card.Border.Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 标签页按钮：选中 = 底部 2px 强调线 -->
        <Style x:Key="TabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Size.Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" Padding="12,0">
                            <StackPanel>
                                <ContentPresenter HorizontalAlignment="Center" Height="27"/>
                                <Border x:Name="underline" Height="2" Background="Transparent"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="underline" Property="Background" Value="{StaticResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表行模板：本地/网站/远程共用 -->
        <DataTemplate x:Key="RowTemplate">
            <Border Style="{StaticResource RowStyle}"
                    PreviewMouseLeftButtonDown="OnRowMouseDown"
                    MouseMove="OnRowMouseMove">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="启动" Click="OnMenuLaunch"/>
                        <MenuItem Header="编辑…" Click="OnMenuEdit"/>
                        <Separator/>
                        <MenuItem Header="上移" Click="OnMenuMoveUp"/>
                        <MenuItem Header="下移" Click="OnMenuMoveDown"/>
                        <Separator/>
                        <MenuItem Header="移除收藏" Click="OnMenuRemove"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Left" Width="{StaticResource Tile.ListIcon}"
                          Height="{StaticResource Tile.ListIcon}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GlyphChar}" FontFamily="{StaticResource Glyph.Font}"
                                   FontSize="13" Foreground="{StaticResource Brush.Text.Tertiary}"/>
                        <Image Source="{Binding IconImage}" Stretch="Uniform"
                               Visibility="{Binding IconVisibility}"/>
                    </Grid>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Entry.Target}"
                               FontSize="{StaticResource Font.Size.Status}"
                               Foreground="{StaticResource Brush.Text.Tertiary}"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                    <TextBlock Text="{Binding Entry.Name}" VerticalAlignment="Center"
                               FontSize="{StaticResource Font.Size.Primary}"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- ListBox 容器去壳：收藏行不留选中底色，行内 Border 自己管 hover -->
        <Style x:Key="RowContainer" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <!-- 侧栏条目：色条 + 名称 + 计数；内底透明，让容器的选中色铺满整行 -->
        <DataTemplate x:Key="SideTemplate">
            <Border Padding="6,4" CornerRadius="4" Background="Transparent">
                <DockPanel LastChildFill="False">
                    <Border DockPanel.Dock="Left" Width="4" Height="16" CornerRadius="2" Margin="0,0,8,0"
                            Background="{Binding ColorBrush}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" VerticalAlignment="Center"
                               FontSize="{StaticResource Font.Size.Status}"
                               Foreground="{StaticResource Brush.Text.Tertiary}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" FontSize="{StaticResource Font.Size.Primary}"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SubLabel}" FontSize="{StaticResource Font.Size.Status}"
                                   Foreground="{StaticResource Brush.Text.Tertiary}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding SubVisibility}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- 侧栏容器：选中 = 整行浅蓝（用户点名"底部也要染"），悬停 = 淡灰；
             描边常驻 1px 但默认透明 —— 只为落点高亮能改色而不抖动布局。 -->
        <Style x:Key="SideContainer" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Selection}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Subtle.Hover}"/>
                            </MultiTrigger>
                            <!-- 排最后 = 压过上面两条：命中项必须一眼可辨，哪怕它正是当前选中的那一项 -->
                            <Trigger Property="a:SideDropTarget.IsHot" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Drop.Unfile}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- 这里**绝不能**写 Focusable=False：ListBoxItem 的鼠标选择是
                 `if (Selector.UiGetIsSelectable(this) && Focus())`，不可聚焦时 Focus() 返回 false，
                 整段选择逻辑被跳过 —— 表现就是"分组看得见、点不动"。
                 （UIA 的 SelectionItemPattern.Select() 直接改选中项、绕开鼠标，所以自动化一直测不出这个 bug。）
                 不想让它进 Tab 序列就用 IsTabStop=False（不影响 Focus()）；焦点框省掉，整行染底已经说明选中。 -->
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- 页面顶部添加条的公共底 -->
        <Style x:Key="AddBar" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke.Default}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource Row.Header}"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="{StaticResource Row.Status}"/>
        </Grid.RowDefinitions>

        <!-- ── 拖拽投放区：拖拽时顶掉"标签条 + 输入框"，松手即执行（取代旧的"拖出窗口"） ── -->
        <Grid x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top"
              Visibility="Collapsed" Panel.ZIndex="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ZoneUnfile" Grid.Column="0" AllowDrop="True" Drop="OnDropUnfile"
                    Background="{StaticResource Brush.Surface.Card}"
                    BorderBrush="{StaticResource Brush.Stroke.Default}" BorderThickness="0,0,1,1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource Glyph.Font}" FontSize="15"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource Brush.Text.Secondary}"/>
                    <TextBlock Text="脱离分类" FontSize="{StaticResource Font.Size.Primary}"
                               VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}"/>
                </StackPanel>
            </Border>
            <Border x:Name="ZoneDelete" Grid.Column="1" AllowDrop="True" Drop="OnDropDelete"
                    Background="{StaticResource Brush.Surface.Card}"
                    BorderBrush="{StaticResource Brush.Stroke.Default}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Glyph.Font}" FontSize="15"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource Brush.Danger}"/>
                    <TextBlock Text="删除" FontSize="{StaticResource Font.Size.Primary}"
                               VerticalAlignment="Center" Foreground="{StaticResource Brush.Danger}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 拖影层：跟随光标的半透明条目副本（不参与命中测试，免得挡住投放区） -->
        <Canvas x:Name="DragLayer" Grid.RowSpan="3" IsHitTestVisible="False" Panel.ZIndex="60"/>

        <!-- ── 标签条：四页切换；空白处拖窗口；关闭键在最右 ── -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Surface.Card}"
                BorderBrush="{StaticResource Brush.Stroke.Default}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <!-- 地图选择器：四页的分组/条目/配色/顺序作为一个整体布局，可建多张随时切 -->
                <DockPanel DockPanel.Dock="Left" Margin="8,0,10,0" VerticalAlignment="Center"
                           shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button DockPanel.Dock="Right" x:Name="MapAddBtn"
                            Style="{StaticResource GhostButton}" Width="22" Height="22"
                            Padding="0" Click="OnMapAddClick" ToolTip="新建地图（四页布局存成一个文件）">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource Glyph.Font}" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <ComboBox x:Name="MapCombo" Width="128" Height="22" VerticalContentAlignment="Center"
                              FontSize="{StaticResource Font.Size.Status}"
                              DisplayMemberPath="Display" SelectedValuePath="Name"
                              SelectionChanged="OnMapSelected"
                              ToolTip="当前地图：四页的分组/条目/配色/顺序作为一个整体布局"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="2,0,0,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton x:Name="Tab0" Style="{StaticResource TabStyle}" GroupName="pg"
                                 IsChecked="True" Checked="OnTabChanged">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xECA5;" FontFamily="{StaticResource Glyph.Font}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="程序" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Tab1" Style="{StaticResource TabStyle}" GroupName="pg" Checked="OnTabChanged">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Glyph.Font}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="本地" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Tab2" Style="{StaticResource TabStyle}" GroupName="pg" Checked="OnTabChanged">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource Glyph.Font}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="网站" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Tab3" Style="{StaticResource TabStyle}" GroupName="pg" Checked="OnTabChanged">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE968;" FontFamily="{StaticResource Glyph.Font}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="远程" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <!-- 关闭键在最右（用户点名）；设置在其左 -->
                <Button DockPanel.Dock="Right" Style="{StaticResource HeaderButton}"
                        ToolTip="关闭 (Esc)" Click="OnCloseClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Glyph.Font}"
                               FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource HeaderButton}"
                        ToolTip="设置" Click="OnSettingsClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource Glyph.Font}"
                               FontSize="13" Foreground="{StaticResource Brush.Text.Secondary}"/>
                </Button>
            </DockPanel>
        </Border>

        <!-- ── 页面主体：添加输入框在每页顶部（v3） ── -->
        <Grid Grid.Row="1">
            <!-- 程序页：左侧分组侧栏 + 右侧磁贴 -->
            <DockPanel x:Name="TilePage">
                <Border x:Name="AddBarTile" DockPanel.Dock="Top" Style="{StaticResource AddBar}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="从应用清单添加…" Style="{StaticResource GhostButton}" Click="OnAddFromInventory"/>
                        <Button Content="添加 exe 文件…" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Click="OnAddExeFile" ToolTip="便携程序直接选 exe，不用进开始菜单"/>
                    </StackPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Brush.Surface.Card}"
                            BorderBrush="{StaticResource Brush.Stroke.Default}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="10,8,8,4" LastChildFill="False">
                                <TextBlock Text="分组" FontSize="{StaticResource Font.Size.Status}"
                                           Foreground="{StaticResource Brush.Text.Tertiary}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Width="20" Height="20"
                                        Padding="0" Click="OnSideAddClick" ToolTip="新建分组">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource Glyph.Font}" FontSize="11"/>
                                </Button>
                            </DockPanel>
                            <ListBox x:Name="TileSideList" SelectionChanged="OnTileSideSelected"
                                     Background="Transparent" BorderThickness="0" Margin="0,0,4,0"
                                     ItemContainerStyle="{StaticResource SideContainer}"
                                     ItemTemplate="{StaticResource SideTemplate}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AllowDrop="True" Drop="OnSideDrop"
                                     DragOver="OnSideDragOver" DragLeave="OnSideDragLeave"
                                     PreviewMouseRightButtonUp="OnSideRightUp"/>
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="{StaticResource Grid.Padding}">
                            <TextBlock x:Name="EmptyTiles"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="{StaticResource Font.Size.Primary}"
                                       Foreground="{StaticResource Brush.Text.Tertiary}"/>
                            <ItemsControl x:Name="TileList" ItemsSource="{Binding}"
                                          AllowDrop="True" Drop="OnTileListDrop" DragOver="OnListDragOver">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="tileRoot"
                                                Style="{StaticResource TileStyle}"
                                                PreviewMouseLeftButtonDown="OnTileMouseDown"
                                                MouseMove="OnTileMouseMove"
                                                PreviewMouseLeftButtonUp="OnTileMouseUp">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="启动" Click="OnMenuLaunch"/>
                                                    <MenuItem Header="编辑…" Click="OnMenuEdit"/>
                                                    <Separator/>
                                                    <MenuItem Header="上移" Click="OnMenuMoveUp"/>
                                                    <MenuItem Header="下移" Click="OnMenuMoveDown"/>
                                                    <Separator/>
                                                    <MenuItem Header="移除收藏" Click="OnMenuRemove"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Border Style="{StaticResource TileShadowLayer}"/>
                                                <StackPanel>
                                                    <Grid Height="{StaticResource Tile.Icon}" Width="{StaticResource Tile.Icon}"
                                                          HorizontalAlignment="Center" Margin="0,8,0,2">
                                                        <!-- 图标底卡：白色小圆角 + 常驻轻阴影，透明底图标放上面有层次 -->
                                                        <Border Background="{StaticResource Brush.Surface.Card}"
                                                                BorderBrush="{StaticResource Brush.Stroke.Default}"
                                                                BorderThickness="1" CornerRadius="4"
                                                                Effect="{StaticResource TileIconShadow}"/>
                                                        <TextBlock Text="{Binding GlyphChar}" FontFamily="{StaticResource Glyph.Font}"
                                                                   FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Brush.Text.Tertiary}"
                                                                   Visibility="{Binding PlaceholderVisibility}" Margin="2"/>
                                                        <Image Source="{Binding IconImage}" Stretch="Uniform"
                                                               Visibility="{Binding IconVisibility}" Margin="2"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Entry.Name}" FontSize="{StaticResource Font.Size.TileLabel}"
                                                               Foreground="{StaticResource Brush.Text.Primary}"
                                                               TextAlignment="Center" TextWrapping="Wrap"
                                                               MaxHeight="30" TextTrimming="CharacterEllipsis"
                                                               Margin="2,0,2,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- 本地/网站列表页：左侧筛选侧栏（本地=盘符分区，网站=书签文件夹）+ 右侧收藏 -->
            <DockPanel x:Name="ListPage" Visibility="Collapsed">
                <Border x:Name="AddBarList" DockPanel.Dock="Top" Style="{StaticResource AddBar}">
                    <Grid>
                        <DockPanel x:Name="AddLocal" LastChildFill="False">
                            <Button Content="选择文件夹收藏…" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Click="OnAddFolder"/>
                        </DockPanel>
                        <DockPanel x:Name="AddWeb" Visibility="Collapsed" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="导入书签…" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Click="OnImportBookmarks" ToolTip="从 Chrome/Edge 或导出的 HTML 导入"/>
                            <Button DockPanel.Dock="Right" Content="＋ 收藏" Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0" Click="OnAddWeb"/>
                            <TextBlock DockPanel.Dock="Left" Text="网址" Style="{StaticResource AddLabel}"/>
                            <TextBox x:Name="WebUrl" Style="{StaticResource AddBox}" ToolTip="如 github.com（可省 https://），收藏后可右键改名"
                                     KeyDown="OnWebBoxEnter"/>
                        </DockPanel>
                    </Grid>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Brush.Surface.Card}"
                            BorderBrush="{StaticResource Brush.Stroke.Default}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="10,8,8,4" LastChildFill="False">
                                <TextBlock x:Name="SideHeader" Text="分组" FontSize="{StaticResource Font.Size.Status}"
                                           Foreground="{StaticResource Brush.Text.Tertiary}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Width="20" Height="20"
                                        Padding="0" Click="OnSideAddClick" ToolTip="新建分组">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource Glyph.Font}" FontSize="11"/>
                                </Button>
                            </DockPanel>
                            <ListBox x:Name="SideList" SelectionChanged="OnSideSelected"
                                     Background="Transparent" BorderThickness="0" Margin="0,0,4,0"
                                     ItemContainerStyle="{StaticResource SideContainer}"
                                     ItemTemplate="{StaticResource SideTemplate}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AllowDrop="True" Drop="OnSideDrop"
                                     DragOver="OnSideDragOver" DragLeave="OnSideDragLeave"
                                     PreviewMouseRightButtonUp="OnSideRightUp"/>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Column="1">
                        <TextBlock x:Name="EmptyRows" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="{StaticResource Font.Size.Primary}"
                                   Foreground="{StaticResource Brush.Text.Tertiary}"/>
                        <ListBox x:Name="RowList" ItemsSource="{Binding}"
                                 Background="Transparent" BorderThickness="0" Padding="8,4"
                                 ItemContainerStyle="{StaticResource RowContainer}"
                                 ItemTemplate="{StaticResource RowTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AllowDrop="True" Drop="OnListDrop" DragOver="OnListDragOver"/>
                    </Grid>
                </Grid>
            </DockPanel>

            <!-- 远程页：左=易远传站点清单（复用 connections.json），右=该站点的收藏 -->
            <Grid x:Name="RemotePage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource Brush.Surface.Card}"
                        BorderBrush="{StaticResource Brush.Stroke.Default}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="易远传站点" Margin="10,8,0,4"
                                   FontSize="{StaticResource Font.Size.Status}"
                                   Foreground="{StaticResource Brush.Text.Tertiary}"/>
                        <TextBlock DockPanel.Dock="Bottom" x:Name="SitesHint" Margin="10,4,8,8"
                                   FontSize="{StaticResource Font.Size.Status}" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Text.Tertiary}"/>
                        <ListBox x:Name="SitesList" SelectionChanged="OnSiteSelected"
                                 Background="Transparent" BorderThickness="0" Margin="0,0,4,0"
                                 ItemContainerStyle="{StaticResource SideContainer}"
                                 ItemTemplate="{StaticResource SideTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseRightButtonUp="OnSideRightUp"/>
                    </DockPanel>
                </Border>
                <DockPanel Grid.Column="1">
                    <Border x:Name="AddBarRemote" DockPanel.Dock="Top" Style="{StaticResource AddBar}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="＋ 收藏" Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0" Click="OnAddRemote"/>
                            <Button DockPanel.Dock="Right" Content="直达" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Click="OnOpenRemoteDirect"
                                    ToolTip="不收藏，直接打开这个路径（回车同效）"/>
                            <TextBlock DockPanel.Dock="Left" Text="路径" Style="{StaticResource AddLabel}"
                                       ToolTip="站点上的绝对路径，如 /home/zhou/docs"/>
                            <TextBox x:Name="RemotePath" Style="{StaticResource AddBox}"
                                     ToolTip="站点上的绝对路径，如 /home/zhou/docs；回车直达，点＋收藏"
                                     KeyDown="OnRemoteBoxEnter"/>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <TextBlock x:Name="EmptyRemote" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   FontSize="{StaticResource Font.Size.Primary}"
                                   Foreground="{StaticResource Brush.Text.Tertiary}"/>
                        <ListBox x:Name="RemoteList" ItemsSource="{Binding}"
                                 Background="Transparent" BorderThickness="0" Padding="8,4"
                                 ItemContainerStyle="{StaticResource RowContainer}"
                                 ItemTemplate="{StaticResource RowTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AllowDrop="True" Drop="OnListDrop" DragOver="OnListDragOver"/>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- ── 状态条 ── -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Surface.Card}"
                BorderBrush="{StaticResource Brush.Stroke.Default}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" x:Name="CountText" Margin="8,0,10,0"
                           VerticalAlignment="Center" FontSize="{StaticResource Font.Size.Status}"
                           Foreground="{StaticResource Brush.Text.Tertiary}"/>
                <TextBlock x:Name="StatusText" Margin="10,0,8,0" VerticalAlignment="Center"
                           FontSize="{StaticResource Font.Size.Status}"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
