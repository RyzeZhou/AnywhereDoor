<Window x:Class="Awd.GUI.BookmarkImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入浏览器书签"
        Width="520" Height="600" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Surface}"
        FontFamily="{StaticResource Font.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <DockPanel Margin="8" LastChildFill="True">
        <!-- 来源：自动探测到的浏览器 + 导出的 HTML 文件 -->
        <DockPanel DockPanel.Dock="Top" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="来源" Style="{StaticResource AddLabel}"/>
            <ComboBox x:Name="SourceBox" Height="24" FontSize="{StaticResource Font.Size.Primary}"
                      VerticalContentAlignment="Center" SelectionChanged="OnSourceChanged"/>
        </DockPanel>

        <Border DockPanel.Dock="Top" Margin="0,8,0,0">
            <TextBlock x:Name="SummaryText" FontSize="{StaticResource Font.Size.Status}"
                       Foreground="{StaticResource Brush.Text.Tertiary}"
                       Text="选个来源，勾掉不要的文件夹"/>
        </Border>

        <!-- 底部：统计 + 按钮 -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="ImportHint" VerticalAlignment="Center"
                       FontSize="{StaticResource Font.Size.Status}"
                       Foreground="{StaticResource Brush.Text.Secondary}"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="导入" Style="{StaticResource GhostButton}" Width="72" Margin="0,0,8,0" Click="OnImport"/>
                <Button Content="取消" Style="{StaticResource GhostButton}" Width="60" IsCancel="True"/>
            </StackPanel>
        </Grid>

        <!-- 勾选要导入的文件夹（填充剩余空间，ListBox 原生虚拟化扛大批书签） -->
        <ListBox x:Name="FolderList"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Height="24" LastChildFill="False">
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Checked, Mode=TwoWay}"
                                  VerticalAlignment="Center" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" VerticalAlignment="Center"
                                   Margin="8,0,0,0" FontSize="{StaticResource Font.Size.Status}"
                                   Foreground="{StaticResource Brush.Text.Tertiary}"/>
                        <TextBlock Text="{Binding Folder.Path}" VerticalAlignment="Center" Margin="6,0,0,0"
                                   FontSize="{StaticResource Font.Size.Primary}"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
