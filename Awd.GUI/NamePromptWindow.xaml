<Window x:Class="Awd.GUI.NamePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" MinWidth="340"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Surface}"
        FontFamily="{StaticResource Font.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <StackPanel Margin="12">
        <TextBlock x:Name="PromptText" FontSize="{StaticResource Font.Size.Primary}"
                   Foreground="{StaticResource Brush.Text.Secondary}"/>
        <TextBox x:Name="Box" Style="{StaticResource AddBox}" Margin="0,8,0,0"
                 KeyDown="OnBoxKeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Style="{StaticResource PrimaryButton}" Width="72" Margin="0,0,8,0" Click="OnOk"/>
            <Button Content="取消" Style="{StaticResource GhostButton}" Width="60" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
